# ================================================================
# Manna Agency Hub — Environment Variables
# Copy this file to .env and fill in all values before starting.
# NEVER commit the actual .env file to version control.
# ================================================================

# ── Server ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (MySQL) ─────────────────────────────────────────────
DATABASE_URL=mysql://manna_user:CHANGE_ME@localhost:3306/manna_hub

# ── Session security ─────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_CHAR_HEX

# ── Manus OAuth (platform auth) ──────────────────────────────────
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
# Manus Forge API (Gemini proxy — used for admin AI tasks)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── Anthropic Claude (MannaBot chatbot) ──────────────────────────
# Get from https://console.anthropic.com → API keys
# CRITICAL: This key must NEVER appear in frontend code.
# It is used server-side only via the /api/trpc/aiChat tRPC proxy.
ANTHROPIC_API_KEY=sk-ant-api03-CHANGE_ME

# ── PayFast (payments) ───────────────────────────────────────────
# Merchant ID: from PayFast dashboard → Settings → Integration
PAYFAST_MERCHANT_ID=34228175
# Passphrase: set in PayFast dashboard → Settings → Integration → Passphrase
PAYFAST_PASSPHRASE=CHANGE_ME
# Set to true to use PayFast sandbox for testing (disables IP whitelist check)
PAYFAST_SANDBOX=false

# ── Meta — WhatsApp Cloud API ────────────────────────────────────
# From Meta for Developers → App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=EAABcd_CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=123456789_CHANGE_ME
# MUST be a random secret — do NOT use a guessable value
# Generate with: openssl rand -hex 32
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_32_CHAR_HEX

# ── Meta — Facebook Lead Ads ─────────────────────────────────────
# From Meta for Developers → App → Settings → Basic → App Secret
FACEBOOK_APP_SECRET=CHANGE_ME
# Same approach as WhatsApp verify token
FACEBOOK_VERIFY_TOKEN=CHANGE_ME_32_CHAR_HEX

# ── Email — Zoho SMTP ────────────────────────────────────────────
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=support@mannadigitalhub.co.za
# Zoho app-specific password (Settings → Security → App Passwords)
SMTP_PASS=CHANGE_ME
